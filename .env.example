# Ollama Local LLM Configuration
# Coroncilia — AI Reconciliation Engine

# ── Ollama (Primary AI Backend) ──────────────────────────────────────────────

# Base URL of the local Ollama instance.
# Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Model used for semantic narration matching and reconciliation logic.
# Must be pulled first: `ollama pull llama3.1:8b`
OLLAMA_MODEL=llama3.1:8b

# Optional vision model for future OCR / document tasks.
# Pull with: `ollama pull minicpm-v`
OLLAMA_VISION_MODEL=minicpm-v

# Timeout for each Ollama request in milliseconds.
# llama3.1:8b on an HP ZBook Firefly G9 typically responds in 3-15s.
OLLAMA_TIMEOUT=60000

# ── Vite Frontend Env Vars ───────────────────────────────────────────────────
# These are exposed to the React bundle (prefix VITE_ is required by Vite).

VITE_OLLAMA_HOST=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.1:8b
VITE_OLLAMA_TIMEOUT=60000

# ── Application ───────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
